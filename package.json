{
  "name": "@lukawi/toporealm-workflow",
  "version": "1.0.0",
  "description": "Workflow domain module for TopoRealm 1.0 — seven-state task lifecycle, evidence-gated completion, dependency/fallback/iteration topology (wf.* namespace)",
  "keywords": ["toporealm", "workflow", "agents", "task-graph"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUKAWI/toporealm-workflow.git"
  },
  "homepage": "https://github.com/LUKAWI/toporealm-workflow#readme",
  "bugs": {
    "url": "https://github.com/LUKAWI/toporealm-workflow/issues"
  },
  "toporealm": "module.yaml",
  "engines": {
    "node": ">=20.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module.yaml": "./module.yaml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "module.yaml",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@lukawi/toporealm-client": "file:../toporealm/packages/client",
    "@lukawi/toporealm-daemon-core": "file:../toporealm/packages/daemon-core",
    "@lukawi/toporealm-module-host": "file:../toporealm/packages/module-host",
    "@lukawi/toporealm-module-sdk": "file:../toporealm/packages/module-sdk",
    "@lukawi/toporealm-protocol": "file:../toporealm/packages/protocol",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
