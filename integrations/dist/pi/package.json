{
  "name": "@lukawi/toporealm-workflow-pi",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "workflow",
    "toporealm"
  ],
  "bin": {
    "toporealm-workflow": "./bin/workflow.mjs"
  },
  "pi": {
    "extensions": [
      "./index.js"
    ],
    "skills": [
      "./skills/workflow",
      "./skills/workflow-design",
      "./skills/workflow-join",
      "./skills/workflow-execute",
      "./skills/workflow-review",
      "./skills/workflow-tdd"
    ]
  },
  "mcpServers": {
    "toporealm": {
      "command": "npx",
      "args": [
        "-y",
        "@lukawi/toporealm@0.1.3",
        "mcp"
      ]
    }
  }
}
